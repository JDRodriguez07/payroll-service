# Copy this file to .env and replace every password placeholder locally.
# Never commit the resulting .env file.

# MySQL
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
DB_NAME=db_payroll_service
DB_USERNAME=payroll_service_user
DB_PASSWORD=replace-with-a-strong-database-password

# Service integration
USER_MANAGEMENT_BASE_URL=http://backend-usermanagment:8080

# Optional host-port overrides
PAYROLL_DB_HOST_PORT=1121
ADMINER_HOST_PORT=1122
PAYROLL_API_HOST_PORT=1123

# Scheduled-job time zone
TZ=America/Bogota

